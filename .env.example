# Configuracoes locais do Espaco Cafe EBM

# Servidor web
APP_HOST=127.0.0.1
APP_PORT=5000
WAITRESS_THREADS=4

# Flask
DEBUG=false
SECRET_KEY=troque-esta-chave-em-producao
SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false

# Banco de dados
# Padrao recomendado para experimento: SQLite em memoria, sem persistencia.
DATABASE_URL=sqlite:///:memory:

# Para persistir em arquivo quando o SQLite local estiver saudavel:
# DATABASE_URL=sqlite:///cafe_dev.db
