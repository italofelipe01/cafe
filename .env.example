# Configuracoes locais do Copa Pronta
# Copie para .env e ajuste. O arquivo .env nao vai para o repositorio.

# --- Ambiente ---------------------------------------------------------------
# development | testing | production
APP_ENV=development

# --- Servidor web -----------------------------------------------------------
APP_HOST=127.0.0.1
APP_PORT=5000
WAITRESS_THREADS=4

# --- Flask ------------------------------------------------------------------
DEBUG=false

# Assina o cookie de sessao. Obrigatoria fora de desenvolvimento: a aplicacao
# recusa subir em producao enquanto este valor for o padrao.
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=troque-esta-chave-em-producao

SESSION_COOKIE_SAMESITE=Lax
SESSION_COOKIE_SECURE=false

# --- Acesso aos paineis internos --------------------------------------------
# Vazio significa painel indisponivel. Em producao as duas sao obrigatorias.
# O formulario de pedido continua publico, sem senha.
ADMIN_PASSWORD=
COPA_PASSWORD=

# --- Banco de dados ---------------------------------------------------------
# Padrao para experimento: SQLite em memoria, sem persistencia.
DATABASE_URL=sqlite:///:memory:

# Para persistir em arquivo:
# DATABASE_URL=sqlite:///cafe_dev.db

# Cria o esquema e semeia o catalogo na inicializacao. Deixe em False quando o
# banco for persistente: nesse caso o esquema vem de `flask db upgrade`.
AUTO_CREATE_DB=True

# --- Operacao ---------------------------------------------------------------
RATELIMIT_ENABLED=true

LOG_LEVEL=INFO
# Caminho de um log rotativo em arquivo. Vazio = apenas saida padrao.
LOG_FILE=
