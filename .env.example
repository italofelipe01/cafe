# Configuracoes locais do Copa Pronta
# Copie para .env e ajuste. O arquivo .env nao vai para o repositorio.
#
# Atalho para uso continuo na rede local: `python run.py --setup` gera um .env
# pronto, com SECRET_KEY e senhas novas, banco em arquivo e migrations
# automaticas.
#
# Variavel vazia vale o mesmo que ausente: o padrao do ambiente escolhido.

# --- Ambiente ---------------------------------------------------------------
# development | testing | production
APP_ENV=development

# --- Servidor web -----------------------------------------------------------
APP_HOST=127.0.0.1
APP_PORT=5000
WAITRESS_THREADS=4
# Na nuvem, PORT (definida pela plataforma) vale quando APP_PORT nao estiver.

# Endereco publico do portal, usado nos QR codes das salas. Vazio = o endereco
# pelo qual a pagina foi aberta. Ex.: http://192.168.0.10:5000
PUBLIC_BASE_URL=

# Proxies reversos confiaveis na frente da aplicacao (nginx, balanceador da
# nuvem). Com 0, X-Forwarded-For e ignorado.
TRUST_PROXY_HOPS=0

# --- Flask ------------------------------------------------------------------
# Vazio = padrao do ambiente (ligado em development, desligado nos demais).
DEBUG=

# Assina o cookie de sessao. Obrigatoria fora de desenvolvimento: a aplicacao
# recusa subir em producao com a chave padrao ou com um valor de exemplo.
# Gere com: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

SESSION_COOKIE_SAMESITE=Lax
# Vazio = padrao do ambiente (true em producao). Em HTTP na rede local, false:
# com true o navegador so devolve o cookie por HTTPS e o login nao se mantem.
SESSION_COOKIE_SECURE=

# --- Acesso aos paineis internos --------------------------------------------
# Vazio = padrao do ambiente: "admin" e "copa" em development; em producao as
# duas sao obrigatorias. O formulario de pedido continua publico, sem senha.
ADMIN_PASSWORD=
COPA_PASSWORD=

# --- Banco de dados ---------------------------------------------------------
# Padrao para experimento: SQLite em memoria, sem persistencia.
DATABASE_URL=sqlite:///:memory:

# Para persistir em arquivo (caminho relativo a pasta instance/):
# DATABASE_URL=sqlite:///copa.db
# PostgreSQL (pip install -r requirements-postgres.txt):
# DATABASE_URL=postgresql://usuario:senha@servidor:5432/copa

# Cria o esquema com db.create_all() e semeia na inicializacao. Serve ao banco
# em memoria. Com banco persistente, deixe False e use AUTO_MIGRATE.
AUTO_CREATE_DB=True

# Ao subir pelo run.py, aplica as migrations pendentes e semeia o catalogo se o
# banco estiver vazio. Vazio = padrao do ambiente (ligado em producao).
AUTO_MIGRATE=

# --- Operacao ---------------------------------------------------------------
RATELIMIT_ENABLED=true
# memory:// vale por processo. Com varias instancias: redis://servidor:6379
RATELIMIT_STORAGE_URI=memory://

# Minutos de espera para o painel da copa destacar o pedido em amarelo e vermelho.
ORDER_WARN_MINUTES=5
ORDER_LATE_MINUTES=10

LOG_LEVEL=INFO
# Caminho de um log rotativo em arquivo (relativo a raiz do projeto). Vazio =
# apenas saida padrao.
LOG_FILE=
